∑# Config del puente GeNIE <-> Earth Rovers SDK.
#
# Derivado de configs/stretch_path_planner.yaml. Los valores de camara son
# PLACEHOLDERS: el Stretch tiene otra optica, otra altura y otra resolucion que
# el FrodoBot. Hay que reemplazarlos antes de mover el robot.

rover:
  base_url: "http://localhost:8000"
  timeout_s: 5.0

samtp:
  config_path: "sam2/configs/sam2.1_inference_tiny/sam2.1_custom2.yaml"
  checkpoint_path: "sam2_logs/configs/sam2.1_training_tiny/sam2_training_custom2_freezeNoneNone_f57.yaml/checkpoints/checkpoint_2.pt"
  device: null          # null = autodetectar cuda, o forza "cuda" / "cpu"

  # auto = bf16 en Ampere o superior, fp16 en Turing (RTX 20xx), que es lo
  # correcto para una 2080. Forza fp32 solo si sospechas de artefactos.
  precision: "auto"
  score_thresh: 0.0

camera:
  calibrated: true

  image_size: [1920, 1080]

  intrinsics:
    - [925.265722853314, 0.0, 962.3052531643399]
    - [0.0, 924.6288195383473, 528.3891677741947]
    - [0.0, 0.0, 1.0]

  dist_coeffs: [-0.26257227523222204, 0.06503885855790396, -0.00031427372195389234, -0.0011895820486559178, -0.0073726075647136185]

  height_m: 0.150
  pitch_down_deg: 1.85

  pose:
    - [-0.000313571, -0.032360666, 0.999476207, 0.000000000]
    - [-0.999953056, 0.009689420, -0.000000000, 0.000000000]
    - [-0.009684345, -0.999429288, -0.032362186, 0.150244633]
    - [0.000000000, 0.000000000, 0.000000000, 1.000000000]
  # Opcion B: si preferis dar la T_world_camera 4x4 completa, poné la matriz
projection:
  ground_z: 0.0
  resolution_m_per_px: 0.03
  forward_range_m: 4.0
  side_range_m: 2.0
  max_ray_distance_m: 6.0

navigation:
  # --- ESTE ES EL PARAMETRO PELIGROSO ---
  # La doc del SDK se contradice: genai_program.py dice que angular positivo es
  # izquierda, el prompt de control_nube.py dice que es derecha.
  # Corré tools/check_angular_sign.py y poné el valor que corresponda.
  #   -1.0  si angular positivo hace girar a la IZQUIERDA
  #   +1.0  si angular positivo hace girar a la DERECHA

planner:
  # Mismos defaults que el Stretch. footprint_px 18 sobre una grilla de 240 px
  # que cubre 4 m equivale a ~0.30 m de ancho de robot: razonable para el
  # FrodoBot, pero medilo y ajustalo.
  grid_size: 240
  unknown_cost: 0.2
  smooth_kernel: 3
  num_goals: 30
  num_mid_points_per_goal: 20
  path_num_samples: 100
  footprint_px: 18
  threshold_cost: 0.50
  threshold_points_ratio: 0.05
  number_of_points_to_filter: 60
  alpha: 1.0
  best_k: 12
  use_clustering: true          # esto es el path fusion del paper
  max_clusters: 4
  cluster_angle_threshold_deg: 40.0
  random_seed: 42
  include_goal_in_path_bank: false
  include_random_goals: true

safety:
  stale_frame_s: 2.0            # video congelado mas de esto => frenar
  max_consecutive_errors: 5
  recovery_after_empty_plans: 3
  recovery_turn_s: 1.5
  # El video del rover llega a 3-5 Hz. Con una GPU decente el modelo va mucho
  # mas rapido que eso, asi que sin este periodo se reprocesan frames identicos
  # y se satura el SDK al pedote. 0.2 s ~ 5 Hz.
  loop_period_s: 0.2
